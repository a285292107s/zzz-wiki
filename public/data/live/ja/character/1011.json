 "talent": {
  "1": {
   "level": 1,
   "name": "急速充電モード",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>の4段目の斬撃が敵に命中した時、アンビーのエネルギー獲得効率+12%、継続時間30秒。",
   "desc2": "「1分間の急速充電で、30分戦えます！」\n——そう断言したのは、武器に拡張機能を追加した専門家だ。\nそして実際、彼の言ったことは正しかった。"
  },
  "2": {
   "level": 2,
   "name": "精密放電",
   "desc": "<color=#FFFFFF>『通常攻撃：落雷』</color>がブレイク状態の敵に命中した時、スキルの与ダメージ+30%。\n<color=#FFFFFF>『強化特殊スキル』</color>がブレイク状態ではない敵に命中した時、スキルの与えるブレイク値+10%。",
   "desc2": "「感電すると、失神する」\n轟音を立てて倒れる敵を眺めながら、少女は淡々と言った——\n「映画で見た通りね」"
  },
  "3": {
   "level": 3,
   "name": "訓練の成果",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "駆け、刀を振るう、雷閃の如く。\n少女はアマチュアではない。ホロウ探索のプロである。"
  },
  "4": {
   "level": 4,
   "name": "電荷伝導",
   "desc": "<color=#FFFFFF>『連携スキル』</color>または<color=#FFFFFF>『終結スキル』</color>を発動した時、控えの電気属性メンバーのエネルギーを3Pt回復する。\nアンビーのエネルギー獲得効率12%につき、回復量が追加で+2Pt、最大+6Pt。",
   "desc2": "単独での戦闘は長期的な解決にならない。\n熟練したホロウレイダーは戦いの最中であっても、\nチームメイトにチャンスを作る。"
  },
  "5": {
   "level": 5,
   "name": "ストリートの経験",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "邪兎屋の仕事は、メンタルを鍛えるだけではない。\n身体能力も（否応なしに）向上する。"
  },
  "6": {
   "level": 6,
   "name": "フィールドチャージ",
   "desc": "<color=#FFFFFF>『強化特殊スキル』</color>を発動した時、アンビーはパワーを8重獲得する（最大8重）。\n<color=#FFFFFF>『通常攻撃』</color>または<color=#FFFFFF>『ダッシュ攻撃』</color>が敵に命中した時、パワーを1重消費することで、その攻撃の与ダメージ+45%。",
   "desc2": "放電の火花が指先で弾ける。\n顔を上げた少女の瞳には、その若さに不釣り合いな強い意志が宿っていた。\nいつか彼女は、この刹那の雷光さえ支配するだろう。"
  }
 },
 "passive": {
