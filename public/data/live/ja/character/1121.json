 "talent": {
  "1": {
   "level": 1,
   "name": "反作用力",
   "desc": "<color=#FFFFFF>『特殊スキル』</color>または<color=#FFFFFF>『強化特殊スキル』</color>を発動し、敵の攻撃をガードした場合、攻撃を仕掛けた敵の与ダメージ-30%、継続時間15秒。",
   "desc2": "「力は相互に作用する。つまり、きみが俺にわざわざ正面からぶつかると…」\n「どうなると思う？計算してみるといい。」"
  },
  "2": {
   "level": 2,
   "name": "守を以て攻と為す",
   "desc": "<color=#FFFFFF>『特殊スキル』</color>または<color=#FFFFFF>『強化特殊スキル』</color>を発動し、ガード反撃を成功させた場合、ベンの防御力300%分の追加ダメージを与える。",
   "desc2": "他のクマのシリオンたちと異なり、ベンのファイトスタイルは非常に辛抱強い。\n防御を疎かにしなければ、敵はきっといつか隙を見せる…そう彼は信じているからだ。"
  },
  "3": {
   "level": 3,
   "name": "緻密な予算計画",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "財務責任者たるもの、緻密な予算計画を立て、\n利用可能なあらゆるリソースを使い、みなと自分を強くすることを学ぶ必要がある。"
  },
  "4": {
   "level": 4,
   "name": "臨機応変",
   "desc": "<color=#FFFFFF>『特殊スキル』</color>または<color=#FFFFFF>『強化特殊スキル』</color>の最中に、無敵効果で敵の攻撃を防いだ場合、その後の反撃の与ダメージ+30%。",
   "desc2": "職業柄、ベンはいかなる時も、状況に応じて臨機応変に対応策を調整する。\n帳尻合わせであれ戦闘であれ、最少の経費で最大の効果を挙げるよう心掛けている。"
  },
  "5": {
   "level": 5,
   "name": "余すところなく",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "ベンの鋭い眼光は、財務諸表の些細な間違いも、\n彼自身の戦い方におけるミスも、何一つ見逃しはしない。\n間違いを正すごとに、彼はどんどん強くなる。"
  },
  "6": {
   "level": 6,
   "name": "野性の闘志",
   "desc": "<color=#FFFFFF>『強化特殊スキル』</color>の最中に攻撃または強力な追加打撃を行うと、<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『ダッシュ攻撃』</color>、<color=#FFFFFF>『回避反撃』</color>の与えるブレイク値+20%、継続時間12秒。",
   "desc2": "クマのシリオンはイヌの場合と異なり、食べ物を与えて宥める方法は通用しない。\n彼らの怒りが爆発した時、我々に出来るのはなるべく早く、できるだけ遠くへ逃げることのみだろう。\n——絶版本『近隣トラブル防止！シリオンと付き合う100の方法』より"
  }
 },
