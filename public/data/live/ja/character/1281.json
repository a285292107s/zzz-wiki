 "talent": {
  "1": {
   "level": 1,
   "name": "のんびりとしたひと時",
   "desc": "<color=#FFFFFF>『特殊スキル：タイヤくるくる』</color>、<color=#FFFFFF>『強化特殊スキル：エンジンぶんぶん』</color>、または<color=#FFFFFF>『終結スキル』</color>の回転斬撃が敵に命中した時、50%の確率で<color=#FFFFFF>「動力」</color>を追加で1重獲得し、<color=#FFFFFF>「動力」</color>を最大30重まで重ね掛けできるようになる。",
   "desc2": "カリュドーンの子、いつも通りの朝。パイパーはのんびりとあくびをしている。\n「ふわぁ…おあよ～す」\n「今日ものんびりしていい～？養生は健康に欠かせないんだぜい。こいつが過労死してもいいのか～」"
  },
  "2": {
   "level": 2,
   "name": "向上心",
   "desc": "<color=#FFFFFF>『特殊スキル：タイヤくるくる』</color>と<color=#FFFFFF>『強化特殊スキル：エンジンぶんぶん』</color>発動中、パイパーの移動速度が早くなる。<color=#FFFFFF>『特殊スキル：億劫な重さ』</color>、<color=#FFFFFF>『強化特殊スキル：兆、重たい』</color>または<color=#FFFFFF>『終結スキル』</color>の落下攻撃が敵に命中した時、スキルの与える<color=#F0D12B>物理属性ダメージ</color>+10%。<color=#FFFFFF>「動力」</color>1重につき、この効果が追加で+1%。",
   "desc2": "一時の努力は、より長い時間休憩するため…\nとはいえ、努力しなくていいに越したことはない。\nパイパーは伸びをすると、トラック内に設えたふかふかのベッドをポンポンして横になった。"
  },
  "3": {
   "level": 3,
   "name": "トラックのプロ",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "パイパーはトラックの全てに興味津々だ。\nエンジン音が響けば、たとえ熟睡していても瞬時に跳ね起きる——\n「100馬力、積載量5トン…おぉ～っ、スリーゲートんとこの新しい軽トラだな～！」"
  },
  "4": {
   "level": 4,
   "name": "熟練のドラテク",
   "desc": "任意のメンバーが敵を状態異常にした時、パイパーのエネルギーが20Pt回復する、30秒に1回のみ発動可能。",
   "desc2": "パイパーの隣に座るには、とてつもない勇気が要る。\n「しっかり座っとくんだぜい～」の「座っ」あたりで、もうトラックはかなりの距離を進んでいるからだ。\nとはいえ彼女は必ず最短時間で、かつ安全に乗客を目的地まで送り届ける。\n安全にというのはあくまで肉体の話であって、精神はこれに含まれない。"
  },
  "5": {
   "level": 5,
   "name": "個人的な趣味",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "パイパーの趣味は、その見た目とはずいぶんギャップがある。\n「このお馬さん、いい足してそうだぁ…ん？\nでも、なんだかオッズが微妙だなぁ。\nあー…こっちのお馬さんのほうが勝ちそうだもんなあ…」\n「うっぷ——ニトロフューエルがこんなにたくさん…もう飲めない…\nいや…もう一杯！」"
  },
  "6": {
   "level": 6,
   "name": "軽い興奮",
   "desc": "<color=#FFFFFF>『強化特殊スキル：エンジンぶんぶん』</color>の最大継続時間が2秒増え、<color=#FFFFFF>「動力」</color>の継続時間が4秒延長される。",
   "desc2": "知っての通り、日々のんびり生きられることがパイパーの一番の願いである。\nそんな少女が、今は目をぱっちり開いている。いつもは気だるそうな瞳に、光を宿して——\n「あんたのためなら…ちょっとは本気を出してもいいぜい～」"
  }
 },
