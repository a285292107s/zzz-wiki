 "talent": {
  "1": {
   "level": 1,
   "name": "堂々登場",
   "desc": "<color=#FFFFFF>『ダッシュ攻撃』</color>または<color=#FFFFFF>『回避反撃』</color>が敵に命中した時、ビリーは追加でエネルギーを2.7Pt回復する、5秒に1回のみ発動可能。",
   "desc2": "「お前ら、悪役にしては大人しすぎねぇか？」\n「主人公に倒されるためだけの的みてぇだぜ！」"
  },
  "2": {
   "level": 2,
   "name": "ローミング・ガンスリンガー",
   "desc": "<color=#FFFFFF>『回避反撃』</color>の与ダメージ+25%。\n<color=#FFFFFF>『通常攻撃』</color>中、身躱し射撃が回避アクションと見なされ、スキル発動中に無敵効果を得る。また、<color=#FFFFFF>『極限回避』</color>を発動できる。\n身躱し射撃が<color=#FFFFFF>『極限回避』</color>を発動した場合、<color=#FFFFFF>『回避反撃』</color>が自動で発動される。",
   "desc2": "「撃ち逃げ？スターライトナイトはそんな卑怯なことはしない。あれは戦略的ゲリラ撃ちだ！」\n——輝けるスターライト・交流掲示板の会員「ラブ・愛しのモニカ様」による書き込み。"
  },
  "3": {
   "level": 3,
   "name": "スターライトナイトの教え",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "決して鍛錬を怠らないこと、決して歩みを止めないこと！\nこれはスターライトナイトの掲げる精神である。\nビリーは大真面目にこれを信じ、そして貫いている。"
  },
  "4": {
   "level": 4,
   "name": "スターライト・バリスティクス",
   "desc": "<color=#FFFFFF>『強化特殊スキル』</color>が敵に命中した時、スキルの会心率がターゲットとの距離に応じてアップする。ビリーとターゲットの距離が近いほど、会心率アップ効果が高くなる、最大+32%。",
   "desc2": "ビリー特製の炸裂実包。\nビリーとしては、単に発砲を派手に演出したかっただけなのだが、\nなぜか近距離戦において驚異的な威力を誇る。"
  },
  "5": {
   "level": 5,
   "name": "失われた技術の構造体",
   "desc": "<color=#FFFFFF>『通常攻撃』</color>、<color=#FFFFFF>『回避』</color>、<color=#FFFFFF>『支援スキル』</color>、<color=#FFFFFF>『特殊スキル』</color>、<color=#FFFFFF>『連携スキル』</color>のスキルレベル+2",
   "desc2": "未知の精密部品と類を見ない構造設計が、\nビリーに他の機械人を遙かに凌駕するパフォーマンスと…\nメンテナンスコストをもたらす。"
  },
  "6": {
   "level": 6,
   "name": "スターライト・英雄的瞬間",
   "desc": "敵に累計10回攻撃を命中させた時、または<color=#FFFFFF>『極限回避』</color>を発動した時、ビリーの与ダメージ+6%、最大5重まで重ね掛け可能。敵にノックバックされる、または吹き飛ばされた場合、バフ効果がリセットされる。",
   "desc2": "「ヒュー、ノッてきたぜ！どいてくれアンビー、こっからは俺のステージだ！」\n「…っと、そうだ！アンビー、スターライトナイトのオープニングテーマを流してくれないか？なぁアンビー！？」\n——邪兎屋社内「禁句ベストテン」ノミネート候補、アンビーより提案。"
  }
 },
