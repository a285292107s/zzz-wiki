{
  "name": "zzz-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "verify:assets": "node scripts/verify-fonts.mjs && node scripts/verify-icons.mjs --local && node scripts/generate-featured-birthdays.mjs --check && node scripts/verify-cjk-fonts.mjs",
    "build:deploy": "vite build && node scripts/generate-sitemap.mjs && node scripts/generate-route-html.mjs && node scripts/verify-budget.mjs && node scripts/verify-vercel-config.mjs",
    "build:ci": "pnpm run verify:assets && pnpm run verify:data && vue-tsc -b && pnpm run build:deploy",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "audit": "node scripts/audit-runner.mjs",
    "audit:core": "node scripts/audit-all.mjs --core",
    "preview": "vite preview --port 4175",
    "data": "tsx scripts/build-data.ts",
    "sync": "tsx scripts/sync-data.ts",
    "download:icons": "node scripts/build/download-icons.mjs",
    "download:disc-gifs": "node scripts/build/disc-gifs.mjs",
    "download:wengine-gifs": "node scripts/build/wengine-gifs.mjs",
    "verify:icons": "node scripts/verify-icons.mjs",
    "verify:data": "tsx scripts/verify-data.ts",
    "download:fonts": "node scripts/build/download-fonts.mjs",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "download:fonts:cjk": "node scripts/build/download-cjk-fonts.mjs",
    "verify:fonts:cjk": "node scripts/verify-cjk-fonts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:budget": "node scripts/verify-budget.mjs",
    "subset:fonts:cjk": "node scripts/build/subset-cjk-fonts.mjs",
    "fonts:cjk": "pnpm run download:fonts:cjk && pnpm run subset:fonts:cjk",
    "verify:vercel": "node scripts/verify-vercel-config.mjs",
    "route-html": "node scripts/generate-route-html.mjs",
    "og:cards": "node scripts/build/og-cards.mjs",
    "audit:all": "node scripts/audit-all.mjs",
    "check:diff": "node scripts/check-diff.mjs",
    "check": "node scripts/check-diff.mjs --run",
    "verify:fast": "node scripts/check-diff.mjs --run",
    "verify:ui": "node scripts/verify-ui.mjs",
    "gen:featured-birthdays": "node scripts/generate-featured-birthdays.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "vue": "^3.5.43",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0",
    "zod": "^3.24.1"
  }
}
